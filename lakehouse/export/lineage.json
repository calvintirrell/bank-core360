            "G-01"
          ],
          "plain": "Email address. Only Riverside Bank's system stores one, so Harbor-only customers have none."
        },
        "phone": {
          "sources": [
            {
              "system": "core_a",
              "table": "CUSTMAST.psv",
              "field": "PHONE"
            },
            {
              "system": "core_b",
              "table": "customers.jsonl",
              "field": "phone"
