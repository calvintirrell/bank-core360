            "S-01",
            "G-01"
          ],
          "plain": "First name, Riverside Bank's version when both banks have one."
        },
        "last_name": {
          "sources": [
            {
              "system": "core_a",
              "table": "CUSTMAST.psv",
              "field": "CUST_NAME"
            },
            {
              "system": "core_b",
              "table": "customers.jsonl",
              "field": "last_name"
            }
          ],
          "transform": "title case, Core B preferred",
