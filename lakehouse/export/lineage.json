          "rules": [
            "S-06",
            "G-01"
          ],
          "plain": "City from the customer's address, Riverside Bank's version when both have one."
        },
        "state": {
          "sources": [
            {
              "system": "core_a",
              "table": "CUSTMAST.psv",
              "field": "ST"
            },
            {
              "system": "core_b",
              "table": "customers.jsonl",
              "field": "address.state"
            }
          ],
          "transform": "Core B preferred",
          "rules": [
            "S-06",
            "G-01"
          ],
          "plain": "State from the customer's address, Riverside Bank's version when both have one."
        },
        "postal_code": {
          "sources": [
            {
              "system": "core_a",
              "table": "CUSTMAST.psv",
              "field": "ZIP"
            },
            {
              "system": "core_b",
              "table": "customers.jsonl",
              "field": "address.postal_code"
            }
          ],
          "transform": "Core B preferred",
          "rules": [
            "S-06",
            "G-01"
          ],
          "plain": "Postal code from the customer's address."
        },
        "customer_since": {
          "sources": [
            {
              "system": "core_a",
              "table": "CUSTMAST.psv",
              "field": "OPEN_DT"
            },
            {
              "system": "core_b",
              "table": "customers.jsonl",
              "field": "created_at"
            }
          ],
          "transform": "earliest across cores",
          "rules": [
            "S-02",
            "S-03",
            "G-02"
          ],
          "plain": "The earliest date either bank had a relationship with this person."
        },
        "is_active": {
          "sources": [
            {
              "system": "core_a",
              "table": "CUSTMAST.psv",
              "field": "CUST_STAT"
            },
            {
              "system": "core_b",
